target/
.git/
.github/
node_modules/
**/build/
**/target/
**/node_modules/

# Extension source (extensions come from npm packages or CI artifacts)
plugins/
!plugins/devx/
!plugins/web/
!plugins/storage/
!plugins/notebook/
!plugins/docs/
!plugins/studio/
!plugins/studio/build/
!plugins/pg-meta/
!plugins/postgrest/
!plugins/claw/
!plugins/prometheus/
!plugins/devx-ext/build/release/devx_ext.trex
# webapi native-lib build (Dockerfile.native-lib) needs these plugin trees +
# the webapi-be submodule in context; build dirs are still trimmed by **/target/ etc.
!plugins/webapi/
!plugins/bao/
# pool-client: path dep of libtrexsql_engine (Dockerfile.trexfix) for pool sessions
!plugins/pool-client/
# ...but never the nested submodule .git pointer files re-included above: WebAPI's
# git-commit-id-plugin chokes on a .git that points outside the build context. With
# no .git present it skips cleanly (failOnNoGitDirectory=false). This must come AFTER
# the !plugins/... rules so it wins (last matching pattern decides).
**/.git

# Dockerfile.dx builds the devx_ext extension from source (not in the base image),
# so its source + the shared extension-ci-tools must be in the build context.
# Their heavy build outputs are re-excluded (rebuilt inside the image). The webapi
# native-lib / .trex builds also need extension-ci-tools in context.
!plugins/devx-ext/
!plugins/extension-ci-tools/
plugins/devx-ext/build/
plugins/devx-ext/target/
# Local `make configure` residue (venv with host python paths, platform.txt):
# if copied in, the in-image `make configure` reuses the broken venv and dies
# with "No module named 'duckdb'". CI checkouts never have it; keep local
# builds identical.
plugins/devx-ext/configure/
plugins/extension-ci-tools/build/
plugins/extension-ci-tools/target/

# Misc
.claude/
.specify/
*.md
*.yml
*.yaml
!Dockerfile
.gitmodules
integration-tests/
specs/
