target/
.git/
.github/
node_modules/
**/build/
**/target/
**/node_modules/

# Extension source (extensions come from npm packages or CI artifacts)
plugins/
!plugins/devx/
!plugins/web/
!plugins/storage/
!plugins/notebook/
!plugins/docs/
!plugins/studio/
!plugins/studio/build/
!plugins/pg-meta/
!plugins/devx-ext/build/release/devx_ext.trex
# webapi native-lib build (Dockerfile.native-lib) needs these plugin trees +
# the webapi-be submodule in context; build dirs are still trimmed by **/target/ etc.
!plugins/webapi/
!plugins/bao/
!plugins/extension-ci-tools/
# ...but never the nested submodule .git pointer files re-included above: WebAPI's
# git-commit-id-plugin chokes on a .git that points outside the build context. With
# no .git present it skips cleanly (failOnNoGitDirectory=false). This must come AFTER
# the !plugins/... rules so it wins (last matching pattern decides).
**/.git

# Misc
.claude/
.specify/
*.md
*.yml
*.yaml
!Dockerfile
.gitmodules
integration-tests/
specs/
