# Dockerfile.dx builds the devx_ext extension from source (not in the base image),
# so its source + the shared extension-ci-tools must be in the build context.
# Their heavy build outputs are re-excluded (rebuilt inside the image).
!plugins/devx-ext/
!plugins/extension-ci-tools/
