# Self-contained DevX image.
#
# Bakes the devx plugin (built dist + fn-claude-code/fn-copilot deps) and the
# devx_ext DuckDB extension straight into the trex *dev* image (which already
# ships the claude-code CLI, gh, and playwright that devx relies on). The result
# is a single image that docker-compose.dx.yml runs with NO local builds,
# bind-mounts, or submodule checkouts.
#
# Build:
#   git submodule update --init plugins/extension-ci-tools
#   docker build -f Dockerfile.dx -t trexsql-dx:dev .
# Base image override (e.g. a per-arch CI tag):
#   --build-arg BASE_IMAGE=ghcr.io/ohdsi/trexsql:dev-sha-<sha>-<arch>
#
# Notes:
# - DEVX_EXT_VERSION is passed explicitly: the extension build's metadata step
#   runs `git describe`, which fails inside the build context (no .git) and would
#   otherwise bake the error string into the extension's ABI metadata, making it
#   unloadable. Pass a real version (the git sha in CI).

# Declared globally (before the first FROM) so it is usable in the final FROM.
ARG BASE_IMAGE=ghcr.io/ohdsi/trexsql:dev

# --- Stage 1: build the devx_ext DuckDB extension for the target arch ---
FROM rust:1.88-bookworm AS devx-ext-builder
ARG DEVX_EXT_VERSION=dev
WORKDIR /work/plugins/devx-ext
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv make pkg-config libssl-dev git && \
    rm -rf /var/lib/apt/lists/*
# extension-ci-tools is a sibling (the Makefile includes ../extension-ci-tools).
COPY plugins/extension-ci-tools/ /work/plugins/extension-ci-tools/
COPY plugins/devx-ext/ /work/plugins/devx-ext/
RUN make configure EXTENSION_VERSION="${DEVX_EXT_VERSION}" && \
    make release   EXTENSION_VERSION="${DEVX_EXT_VERSION}" && \
    test -f build/release/devx_ext.trex

# --- Stage 2: build the devx plugin (SPA dist + fn-* runtime deps) ---
FROM node:22-trixie-slim AS devx-builder
WORKDIR /work
COPY plugins/devx/ /work/
# Bundle the trex Docusaurus docs as a local knowledge-base source so the agent
# can query them via the kb MCP server's `trex-docs` source — no clone, no
# network at runtime. Source of truth stays in plugins/docs; this is a build-time
# snapshot. (The `d2e` local source is authored in-repo under fn-claude-code/
# kb-local/d2e and ships via the COPY above.)
COPY plugins/docs/docs/ /work/fn-claude-code/kb-local/trex-docs/
# Build the SPA, then install runtime deps for the two agent sidecar servers.
RUN npm ci && \
    npm run build && \
    (cd fn-claude-code && npm install --omit=dev) && \
    (cd fn-copilot && npm install --omit=dev) && \
    # Root node_modules are build-only (vite/tsc); the runtime uses dist/ + the
    # Deno functions, so drop them to keep the image small.
    rm -rf node_modules

# --- Final: layer devx onto the trex dev image ---
FROM ${BASE_IMAGE}
USER root

# d2e runtime deps (for a FUTURE rebuild; the running dx image predates this).
# - yarn (via Corepack) is needed to install the d2e-ui Nx/yarn-workspaces monorepo.
# - python3 + uv + prefect are needed to actually RUN d2e flows.
#   NOTE: installing them here only makes the binaries PRESENT. Fully RUNNING flows
#   ALSO requires adding `python`/`python3`/`uv`/`prefect` to the Rust
#   `validate_command` allowlist in `plugins/devx-ext/src/validation.rs` (which today
#   only permits npm/npx/yarn/pnpm/node/deno/bun/echo/git/mkdir/sh/cat/cp and injects
#   only PORT) and rebuilding the devx_ext extension — out of scope here. Until then
#   flows are context-only (the flowRun recipe echoes guidance).
# Best-effort: guard with `|| true` so the build still proceeds if apt is unavailable.
RUN (corepack enable || npm i -g yarn) || true
RUN (apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip pipx && \
     rm -rf /var/lib/apt/lists/*) || true
# Prefect for flows (uv preferred; fall back to pip with --break-system-packages).
RUN (pipx install uv || pip3 install --break-system-packages uv || true) && \
    (uv tool install prefect || pip3 install --break-system-packages prefect || true)

# The plugin scanner picks devx up from plugins-dev via its package.json.
COPY --from=devx-builder --chown=node:node /work/ /usr/src/plugins-dev/devx/
# Locally-built DuckDB extension (read by pg_trex at startup).
COPY --from=devx-ext-builder /work/plugins/devx-ext/build/release/devx_ext.trex \
     /usr/lib/trexsql/extensions/devx_ext.trex
# Workspace-less Deno config — keeps Deno from refusing to load the plugin's
# function configs under plugins-dev (matches the runtime-deno.json override).
COPY docker/runtime-deno.json /usr/src/deno.json

USER node
ENTRYPOINT ["/usr/src/entrypoint.sh"]
