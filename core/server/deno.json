{
  "nodeModulesDir": "manual",
  "imports": {
    "ai": "npm:ai@^6",
    "ai/test": "npm:ai@^6/test",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@^3",
    "@ai-sdk/openai": "npm:@ai-sdk/openai@^3",
    "@ai-sdk/google": "npm:@ai-sdk/google@^3",
    "@ai-sdk/amazon-bedrock": "npm:@ai-sdk/amazon-bedrock@^4.0.115",
    "@modelcontextprotocol/sdk/client/index.js": "npm:@modelcontextprotocol/sdk@1/client/index.js",
    "@modelcontextprotocol/sdk/client/sse.js": "npm:@modelcontextprotocol/sdk@1/client/sse.js",
    "@modelcontextprotocol/sdk/client/streamableHttp.js": "npm:@modelcontextprotocol/sdk@1/client/streamableHttp.js",
    "eve": "./agents/eve-shim/mod.ts",
    "eve/tools": "./agents/eve-shim/tools.ts",
    "eve/tools/approval": "./agents/eve-shim/approval.ts",
    "eve/connections": "./agents/connections/shim.ts",
    "eve/channels": "./agents/channels/shim.ts",
    "eve/channels/eve": "./agents/channels/adapters/eve.ts",
    "eve/channels/discord": "./agents/channels/adapters/discord.ts",
    "eve/channels/slack": "./agents/channels/adapters/slack.ts",
    "eve/channels/telegram": "./agents/channels/adapters/telegram.ts",
    "eve/channels/twilio": "./agents/channels/adapters/twilio.ts",
    "eve/channels/github": "./agents/channels/adapters/github.ts",
    "eve/channels/linear": "./agents/channels/adapters/linear.ts",
    "eve/channels/teams": "./agents/channels/adapters/teams.ts",
    "eve/evals": "./agents/eve-shim/evals.ts",
    "edn-data": "npm:edn-data@^1"
  },
  "tasks": {
    "test": "deno test --allow-all",
    "coverage": "rm -rf coverage && deno test --allow-all --coverage=coverage && deno coverage coverage --lcov --output=coverage/lcov.info"
  }
}
