{
  "name": "@trex/claw",
  "version": "0.0.1",
  "trex": {
    "agents": [
      {
        "name": "claw",
        "dir": "agent",
        "env": {
          "CLAW_MODEL_PROVIDER": "${CLAW_MODEL_PROVIDER:-anthropic}",
          "CLAW_MODEL_ID": "${CLAW_MODEL_ID:-claude-sonnet-5}",
          "CLAW_API_KEY": "${CLAW_API_KEY}",
          "CLAW_MODEL_BASE_URL": "${CLAW_MODEL_BASE_URL:-}",
          "DISCORD_BOT_TOKEN": "${DISCORD_BOT_TOKEN}",
          "DISCORD_PUBLIC_KEY": "${DISCORD_PUBLIC_KEY}",
          "DISCORD_APPLICATION_ID": "${DISCORD_APPLICATION_ID}",
          "DISCORD_ALLOWED_USERS": "${DISCORD_ALLOWED_USERS:-}",
          "DISCORD_ALLOWED_CHANNELS": "${DISCORD_ALLOWED_CHANNELS:-}",
          "DISCORD_GATEWAY": "${DISCORD_GATEWAY:-}",
          "DISCORD_MESSAGES": "${DISCORD_MESSAGES:-}",
          "CLAW_CODE_USER_ID": "${CLAW_CODE_USER_ID:-}",
          "CLAW_CODER_PROVIDER": "${CLAW_CODER_PROVIDER:-}",
          "CLAW_CODER_MODEL": "${CLAW_CODER_MODEL:-}",
          "CLAW_DEV_CHANNEL_ID": "${CLAW_DEV_CHANNEL_ID:-}"
        }
      }
    ],
    "migrations": { "schema": "claw", "database": "_config" }
  }
}
