{
  "name": "@trex/fhir-fn",
  "version": "0.1.0",
  "description": "FHIR R4 server as a Trex edge function",
  "type": "module",
  "trex": {
    "functions": {
      "env": {
        "_shared": {
          "FHIR_BASE_PATH": "/trex/fhir"
        }
      },
      "api": [
        { "source": "/fhir", "function": "/functions" }
      ]
    }
  }
}
