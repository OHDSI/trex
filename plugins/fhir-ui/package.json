{
  "name": "@trex/fhir-ui",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist/"
  ],
  "scripts": {
    "vendor": "node scripts/vendor-atlas-ui.mjs",
    "dev": "vite",
    "build": "vue-tsc -b && vite build && vite build --config vite.config.spa.ts && cp \"$(ls dist/assets/index-*.css | head -1)\" dist/fhir-ui-spa.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "trex": {
    "ui": {
      "routes": [
        {
          "path": "/fhir-ui",
          "dir": "dist",
          "spa": true
        }
      ]
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@mdi/font": "^7.4.47",
    "codemirror": "^6.0.0",
    "pinia": "^2.1.0",
    "single-spa-vue": "^3.0.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vuetify": "^3.5.0"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "^1.40.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "sass": "^1.93.3",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
