{
  "name": "@trex/storage",
  "version": "0.1.0",
  "description": "Embedded Supabase Storage (file or S3 backend)",
  "trex": {
    "functions": {
      "env": {
        "_shared": {
          "DATABASE_URL": "${DATABASE_URL}",
          "DATABASE_SEARCH_PATH": "storage,public",
          "STORAGE_BACKEND": "${STORAGE_BACKEND:-file}",
          "FILE_STORAGE_BACKEND_PATH": "${STORAGE_FILE_BACKEND_PATH:-/tmp/storage}",
          "FILE_SIZE_LIMIT": "${STORAGE_FILE_SIZE_LIMIT:-52428800}",
          "IS_MULTITENANT": "false",
          "ANON_KEY": "${PGRST_JWT_SECRET}",
          "SERVICE_KEY": "${PGRST_JWT_SECRET}",
          "REGION": "local",
          "GLOBAL_S3_BUCKET": "local",
          "PGRST_JWT_SECRET": "${PGRST_JWT_SECRET}",
          "AUTH_JWT_SECRET": "${PGRST_JWT_SECRET}",
          "AUTH_JWT_ALGORITHM": "HS256",
          "ENABLE_IMAGE_TRANSFORMATION": "false",
          "PG_QUEUE_ENABLE": "false",
          "HOME": "/tmp",
          "STORAGE_INSTALL_ROLES": "true"
        }
      },
      "api": [
        {
          "source": "/storage-api",
          "function": "/supabase-storage/functions",
          "imports": "/supabase-storage/deno.json",
          "allowHostFsAccess": true
        }
      ]
    }
  }
}
