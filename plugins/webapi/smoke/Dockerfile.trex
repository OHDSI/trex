# syntax=docker/dockerfile:1.4
# End-to-end test of the webapi.trex DuckDB extension: build the extension, load it
# into trexsql/DuckDB, and SELECT webapi_start() to boot the embedded WebAPI server
# (libwebapi-native.so, reused from the webapi-smoke image). Build context = repo root:
#   DOCKER_BUILDKIT=1 docker build -f plugins/webapi/smoke/Dockerfile.trex -t webapi-trex-test .
#   docker run --rm webapi-trex-test
# Requires the local image `webapi-smoke` (holds /app/libwebapi-native.so).

############################
# Stage 1 - build webapi.trex (the DuckDB loadable extension)
############################
FROM ubuntu:24.04 AS ext
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates build-essential clang cmake git \
        python3 python3-venv python3-pip pkg-config libssl-dev unzip \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.89.0
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src
COPY plugins/extension-ci-tools ./plugins/extension-ci-tools
COPY plugins/webapi ./plugins/webapi
WORKDIR /src/plugins/webapi
# EXTENSION_VERSION explicit: the build context has no .git, so the default
# git-describe version detection fails and pollutes the embedded metadata.
RUN make configure EXTENSION_VERSION=v0.1.0 && make release \
    && cp build/release/extension/*/webapi.trex /webapi.trex \
    && ls -lh /webapi.trex

############################
# Stage 2 - build libtrexsql_engine.so (trexsql JNA engine for the embedded servlet)
############################
FROM ubuntu:24.04 AS engine
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates build-essential clang pkg-config libssl-dev git unzip \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
ARG TARGETARCH
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in amd64) A=amd64 ;; arm64) A=arm64 ;; esac \
    && curl -fsSL -o /tmp/t.zip "https://github.com/p-hoffmann/trexsql-rs/releases/download/v1.4.4-trex/libtrexsql-linux-${A}.zip" \
    && mkdir -p /opt/trexsql && unzip -o /tmp/t.zip -d /opt/trexsql
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cargo/registry --mount=type=cache,target=/src/target \
    TREXSQL_LIB_DIR=/opt/trexsql cargo build --release --lib \
    && cp target/release/libtrexsql_engine.so /opt/trexsql/libtrexsql_engine.so

############################
# Stage 3 - runtime: load the extension and boot WebAPI through it
############################
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gcc libc6-dev unzip \
        postgresql postgresql-contrib libfreetype6 fontconfig zlib1g \
    && rm -rf /var/lib/apt/lists/*

# trexsql/DuckDB runtime (libtrexsql.so + duckdb.h) and the trexsql engine.
ARG TARGETARCH
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in amd64) A=amd64 ;; arm64) A=arm64 ;; esac \
    && curl -fsSL -o /tmp/t.zip "https://github.com/p-hoffmann/trexsql-rs/releases/download/v1.4.4-trex/libtrexsql-linux-${A}.zip" \
    && mkdir -p /opt/trexsql && unzip -o /tmp/t.zip -d /opt/trexsql \
    && cp /opt/trexsql/libtrexsql.so /usr/local/lib/ \
    && cp /opt/trexsql/duckdb.h /usr/local/include/ \
    && ldconfig
COPY --from=engine /opt/trexsql/libtrexsql_engine.so /usr/local/lib/
RUN ldconfig
ENV LD_LIBRARY_PATH=/usr/local/lib

WORKDIR /app
COPY --from=ext /webapi.trex /app/webapi.trex
COPY --from=webapi-smoke /app/libwebapi-native.so /app/libwebapi-native.so
COPY plugins/webapi/smoke/trex_test.c /app/trex_test.c
COPY plugins/webapi/smoke/trex-run.sh /app/trex-run.sh
RUN gcc -O2 -I/usr/local/include -o /app/trex_test /app/trex_test.c -L/usr/local/lib -ltrexsql -ldl \
    && chmod +x /app/trex-run.sh

CMD ["bash", "/app/trex-run.sh"]
