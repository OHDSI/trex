<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.trex</groupId>
  <artifactId>webapi-native-lib</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>WebAPI Native Shared Library (with trexsql)</name>
  <description>Builds libwebapi-native.so embedding OHDSI WebAPI + the trexsql/bao integration via GraalVM native-image.</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring.boot.version>3.5.6</spring.boot.version>
    <!-- Default off so an ad-hoc `mvn package` in this module does not need the
         ephemeral PostgreSQL that Spring AOT requires. build-native-lib.sh passes
         -DskipTests=false explicitly, which is what makes the unit tests run in
         CI; that script is the only Maven invocation for this module. Do not add
         a bare -DskipTests to that command — it silently disables them again. -->
    <skipTests>true</skipTests>
    <!-- Overridden by build-native-lib.sh with the version `lein install`
         actually published, so bumping the plugin cannot orphan this. -->
    <trexsql.version>0.3.1</trexsql.version>
  </properties>

  <!-- Replicate WebAPI's own dependency versions. dependencyManagement is NOT
       transitive, so consuming WebAPI as a plain dependency loses its version
       decisions and lets transitive resolution pick mismatched versions (stale
       slf4j-api shadowing Logback; inconsistent Spring Data → QueryMethod
       NoSuchMethodError). Import the same Spring Boot BOM WebAPI uses to align
       Spring Data / slf4j / logback / tomcat, then override the two deps WebAPI
       pins away from Boot's defaults: Hibernate (Boot 3.5.6's 6.6 rejects a WebAPI
       entity) and Jackson. Direct entries and earlier-declared BOM imports win, so
       order matters: overrides first, Boot BOM last. -->
  <dependencyManagement>
    <dependencies>
      <!-- WebAPI pins hibernate.version=6.5.3.Final (direct entry beats the BOM). -->
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-core</artifactId>
        <version>6.5.3.Final</version>
      </dependency>
      <!-- WebAPI pins jackson 2.18.2 (also what trexsql compiled against); declared
           before the Boot BOM so this jackson-bom wins over Boot's jackson. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.18.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- WebAPI app (installed to local .m2 as a jar by build-native-lib.sh). Brings
         its own transitive Spring Boot / Hibernate / Flyway deps. -->
    <dependency>
      <groupId>org.ohdsi</groupId>
      <artifactId>WebAPI</artifactId>
      <version>3.0.0-SNAPSHOT</version>
    </dependency>

    <!-- trexsql/bao integration (installed to local .m2 by `lein install`).
         Its META-INF AutoConfiguration.imports is what Spring AOT discovers. -->
    <dependency>
      <groupId>org.trex</groupId>
      <artifactId>trexsql</artifactId>
      <version>${trexsql.version}</version>
    </dependency>

    <!-- @CEntryPoint compile visibility (provided; comes from WebAPI jar at runtime). -->
    <dependency>
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>nativeimage</artifactId>
      <version>24.1.1</version>
      <scope>provided</scope>
    </dependency>


    <!-- Clojure native-image support: a native-image Feature that initializes every
         Clojure-compiled class at BUILD time. Without it, clojure.lang.RT bootstraps
         at runtime and compiles clojure/core.clj from source inside the image, which
         fails (NoSuchFieldException: creator at clojure/core.clj:20). Activated by the
         features build arg below. -->
    <dependency>
      <groupId>com.github.clj-easy</groupId>
      <artifactId>graal-build-time</artifactId>
      <version>1.0.6</version>
    </dependency>

    <!-- Unit tests for RuntimeTrustStore (version from the Spring Boot BOM above). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- graal-build-time is published to Clojars, not Maven Central. -->
  <repositories>
    <repository>
      <id>clojars</id>
      <url>https://repo.clojars.org</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <!-- Compile the Java substitution (VarSubstitutions) with JDK 21; the default
           compiler plugin from the super-pom defaults to source/target 5. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>

      <!-- The super-pom's surefire 2.12.4 predates JUnit 5 and would silently run
           nothing; 3.x discovers Jupiter tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- Spring Boot AOT: refreshes the WebApi context at build time and generates
           the AOT sources/classes native-image consumes. Discovers trexsql's
           AutoConfiguration from the classpath. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <configuration>
          <mainClass>org.ohdsi.webapi.WebApi</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>process-aot</id>
            <goals>
              <goal>process-aot</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- GraalVM native-image: build a shared library exporting the @CEntryPoint
           symbols (mirrors webapi-be's native-lib profile, plus our graalvm-config). -->
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <version>0.10.6</version>
        <extensions>true</extensions>
        <configuration>
          <sharedLibrary>true</sharedLibrary>
          <imageName>libwebapi-native</imageName>
          <mainClass>org.ohdsi.webapi.WebApi</mainClass>
          <buildArgs>
            <buildArg>--no-fallback</buildArg>
            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
            <buildArg>-J-Xmx8g</buildArg>
            <!-- This image (WebAPI + trexsql + the whole Clojure runtime) compiles slowly;
                 disable the deadlock watchdog so a slow phase isn't mistaken for a hang. -->
            <buildArg>-H:DeadlockWatchdogInterval=0</buildArg>
            <buildArg>-H:ConfigurationFileDirectories=${project.basedir}/../graalvm-config</buildArg>
            <!-- BouncyCastle JCE provider for WebAPI's Jasypt source-credential encryption
                 (JASYPT_ENCRYPTOR_ENABLED uses BC's PBEWITHSHA256AND256BITAES-CBC-BC).
                 native-image refuses to use a JCE provider it didn't verify at build time
                 ("Trying to verify a provider that was not registered at build time: BC").
                 BcFeature adds BC and triggers its verification at build time (via
                 getInstance, no SecureRandom) so the verified provider is baked into the
                 image; EncryptorUtils must then use it by name (setProviderName("BC")), as a
                 fresh runtime `new BouncyCastleProvider()` has no algorithms (BC is build-
                 time-initialized below). See also graalvm-config/reflect-config.json (BC
                 $Mappings + the PBE impl classes) and java.text.Normalizer (password NFC). -->
            <buildArg>--features=org.trex.webapi.nativelib.BcFeature</buildArg>
            <!-- Build-time-init ALL Clojure classes (trexsql is AOT-compiled Clojure; this
                 keeps clojure.lang.RT from recompiling core from source at runtime AND lets
                 trexsql's own AOT classes load from bytecode at runtime instead of being
                 recompiled). Works because trexsql no longer pulls clojure.data.json (whose
                 load-time (set! *warn-on-reflection*) cannot run at build time) — see
                 trexsql.json. The trexsql Clojure stack drags these non-Clojure libs into
                 build-time init too, so initialize them at build time as well. -->
            <buildArg>--features=clj_easy.graal_build_time.InitClojureClasses</buildArg>
            <!-- Build-time-init clojure.pprint/stacktrace within a *warn-on-reflection*
                 binding (they (set! *warn-on-reflection*) at load, which otherwise throws
                 during build-time init). -->
            <buildArg>--features=org.trex.webapi.nativelib.ClojureInitFeature</buildArg>
            <!-- org.trex.* are Clojure gen-classes; graal-build-time doesn't recognize them
                 as Clojure, so build-time-init them explicitly. Otherwise their <clinit> runs
                 at runtime and recompiles trexsql/api.clj from source (which a closed-world
                 native image can't do). -->
            <buildArg>--initialize-at-build-time=com.fasterxml.jackson,ch.qos.logback,org.slf4j,org.apache.commons.logging,org.apache.commons.codec,clj_tuple__init,potemkin__init,clj_tuple$hash_map,clj_tuple$vector,org.trex.Trexsql,org.trex.TrexServlet,org.trex.webapi.TrexSQLPlugin,org.trex.webapi.TrexSQLSearchProvider,org.bouncycastle,org.jasypt</buildArg>
            <!-- clj-http stays run-time-init: it builds Apache HttpClient's SSL stack (whose
                 SSLConnectionSocketFactory + HostnameVerifiers are pinned run-time by the
                 httpclient reachability metadata), so it must not initialize at build time.
                 It's reached only via runtime requiring-resolve (trexsql.http-client). For that
                 runtime require to load the AOT'd classes instead of recompiling clj_http/*.clj
                 from source (which a closed-world image can't do -> "Syntax error compiling fn*
                 at clj_http/conn_mgr.clj"), two things are needed: (1) AOT clj-http so the
                 clj_http.*__init classes exist (plugins/bao/java project.clj :aot), and (2) drop
                 the clj_http/*.clj source resources from graalvm-config/resource-config.json so
                 RT.load falls through to Class.forName on the compiled __init class. -->
            <!-- BC is build-time-initialized (above), but its DRBG SecureRandom holders must
                 stay run-time-init: build-time init would bake a seeded Random into the image
                 heap ("Detected an instance of Random/SplittableRandom"). Only the inner
                 holders need this; the outer DRBG class is build-time-init (it just registers
                 the SecureRandom service during provider setup). -->
            <buildArg>--initialize-at-run-time=clj_http,org.bouncycastle.jcajce.provider.drbg.DRBG$Default,org.bouncycastle.jcajce.provider.drbg.DRBG$NonceAndIV</buildArg>
          </buildArgs>
        </configuration>
        <executions>
          <execution>
            <id>add-reachability-metadata</id>
            <goals>
              <goal>add-reachability-metadata</goal>
            </goals>
          </execution>
          <execution>
            <id>build-native-lib</id>
            <phase>package</phase>
            <goals>
              <goal>compile-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
